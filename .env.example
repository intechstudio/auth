# Copy to .env. Local development only; every value may stay as is.

# Keycloak's database and bootstrap admin (also used by keycloak-config-cli).
KC_DB_PASSWORD=keycloak
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin

# Base URLs, without a trailing slash. The realm file adds the paths.
# Keycloak has none: it takes its URL from each request (see the README).
# The website: callback, post-logout pages and web origin.
WEBSITE_URL=http://localhost:5173
# Grid Editor web builds, comma-separated; may be empty.
GRID_EDITOR_WEB_URLS=http://localhost:5273
# The forum; empty leaves the discourse client without a redirect.
DISCOURSE_URL=

# Client secrets, set on the clients when the realm is applied.
WEBSITE_CLIENT_SECRET=website-local-secret
DISCOURSE_CLIENT_SECRET=discourse-local-secret

# Google sign-in. true needs a Google OAuth client with the redirect URI
# http://localhost:3001/realms/intechstudio/broker/google/endpoint (and the
# same path on the tunnel hostname, to sign in with Google through it).
GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The recovery email workflow (workflows/recovery-email.json): time between
# batches (s, m, h, d) and users per batch.
RECOVERY_EMAIL_INTERVAL=30s
RECOVERY_EMAIL_BATCH_SIZE=2
# A fixed public URL for Keycloak (the realm's frontendUrl). Empty: each
# request's host. The workflow needs one; set http://localhost:3001 only while
# testing it. It fixes the issuer too, tunnel included.
AUTH_FRONTEND_URL=

# Optional tunnel (`docker compose --profile tunnel up -d`): this developer's
# Cloudflare Tunnel token. Its hostname, routed to http://keycloak:8080, is set
# in Cloudflare; the issuer there is https://<hostname>/realms/intechstudio.
TUNNEL_TOKEN=
