# Read by seed.ts. Compose reads only LOGTO_ENDPOINT.

# Also Logto's ENDPOINT in compose; a public hostname here changes the issuer (README).
LOGTO_ENDPOINT=http://localhost:3001
# Self-hosted Logto's fixed Management API indicator.
LOGTO_MANAGEMENT_API_RESOURCE=https://default.logto.app/api

# From the one-time bootstrap in README.md.
LOGTO_M2M_APP_ID=
LOGTO_M2M_APP_SECRET=

# Comma-separated. Only DISCOURSE_* may be empty.
WEBSITE_REDIRECT_URIS=http://localhost:5173/auth/callback
WEBSITE_POST_LOGOUT_REDIRECT_URIS=http://localhost:5173/,http://localhost:5173/checkout
DISCOURSE_REDIRECT_URIS=
DISCOURSE_POST_LOGOUT_REDIRECT_URIS=
GRID_EDITOR_WEB_REDIRECT_URIS=http://localhost:5273/auth/callback
GRID_EDITOR_POST_LOGOUT_REDIRECT_URIS=grid-editor://auth/logout,http://localhost:5273/

HQ_API_RESOURCE_INDICATOR=http://localhost:3006

# Host and port as Logto reaches them, so the compose service name locally.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=local
SMTP_PASS=local
SMTP_FROM=system@intech.studio

BRANDING_LOGO_URL=https://intech.studio/logo_small_black.svg
BRANDING_DARK_LOGO_URL=https://intech.studio/logo_small_white.svg
BRANDING_PRIMARY_COLOR="#0000FA"
BRANDING_DARK_PRIMARY_COLOR="#F54708"
# Optional path to a Grifter Bold .woff2, embedded into the hosted pages. The
# font is licensed and not in this repo; without it headings use sans-serif.
BRANDING_FONT_PATH=

# Set both to enable the CAPTCHA connector.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
