# Copy to .env. Local development only; every value may stay as is.

# Keycloak's database and bootstrap admin (also used by keycloak-config-cli).
KC_DB_PASSWORD=keycloak
KC_ADMIN_USERNAME=admin
KC_ADMIN_PASSWORD=admin

# Client secrets, set on the clients when the realm is applied.
WEBSITE_CLIENT_SECRET=website-local-secret
DISCOURSE_CLIENT_SECRET=discourse-local-secret

# The forum's OIDC callback, e.g. <forum url>/auth/oidc/callback.
DISCOURSE_REDIRECT_URI=

# A Google OAuth client for local development. Empty leaves the provider
# unconfigured; the realm still applies.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
