{
  "name": "recovery-email",
  "schedule": {
    "after": "${RECOVERY_EMAIL_INTERVAL}",
    "batch-size": "${RECOVERY_EMAIL_BATCH_SIZE}"
  },
  "if": "has-user-attribute(recoveryEmail=pending)",
  "steps": [
    {
      "uses": "invite-user",
      "with": {
        "actions": ["UPDATE_PASSWORD", "VERIFY_EMAIL"],
        "client-id": "website",
        "redirect-uri": "${WEBSITE_URL}/"
      }
    },
    {
      "uses": "remove-user-attribute",
      "with": {
        "attribute": "recoveryEmail"
      }
    }
  ]
}
