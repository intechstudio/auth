{
  "realm": "intechstudio",
  "enabled": true,
  "registrationAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "actionTokenGeneratedByAdminLifespan": 86400,
  "actionTokenGeneratedByUserLifespan": 3600,
  "attributes": {
    "frontendUrl": "$(env:AUTH_URL)"
  },
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "system@intech.studio",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "clients": [
    {
      "clientId": "website",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:WEBSITE_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["$(env:WEBSITE_URL)/auth/callback"],
      "webOrigins": ["$(env:WEBSITE_URL)"],
      "attributes": {
        "post.logout.redirect.uris": "$(env:WEBSITE_URL)/##$(env:WEBSITE_URL)/checkout"
      }
    },
    {
      "clientId": "grid-editor",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": $${javascript: JSON.stringify(['http://127.0.0.1/auth/callback'].concat(env.GRID_EDITOR_WEB_URLS.split(',').map(u => u.trim()).filter(Boolean).map(u => u + '/auth/callback')))},
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "$${javascript: env.GRID_EDITOR_WEB_URLS.split(',').map(u => u.trim()).filter(Boolean).map(u => u + '/').join('##')}"
      }
    },
    {
      "clientId": "discourse",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "$(env:DISCOURSE_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": $${javascript: JSON.stringify(env.DISCOURSE_URL ? [env.DISCOURSE_URL + '/auth/oidc/callback'] : [])}
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": $(env:GOOGLE_ENABLED),
      "trustEmail": true,
      "config": {
        "clientId": "$(env:GOOGLE_CLIENT_ID)",
        "clientSecret": "$(env:GOOGLE_CLIENT_SECRET)"
      }
    }
  ]
}
